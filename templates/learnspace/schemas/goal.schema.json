{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Learning Goal Frontmatter Schema",
  "type": "object",
  "required": [
    "id",
    "title",
    "status",
    "focus",
    "summary",
    "tags",
    "createdAt",
    "updatedAt"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": ["draft", "active", "paused", "completed", "archived"]
    },
    "focus": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "startDate": {
      "type": ["string", "null"],
      "format": "date"
    },
    "targetDate": {
      "type": ["string", "null"],
      "format": "date"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9-]+$"
      }
    },
    "createdAt": {
      "type": "string",
      "format": "date"
    },
    "updatedAt": {
      "type": "string",
      "format": "date"
    }
  },
  "additionalProperties": false
}
